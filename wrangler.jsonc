{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "porto", // Ganti dengan nama unik
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}